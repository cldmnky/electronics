{
  "name": "froemix-euro",
  "version": "0.1.0",
  "description": "Froemix euro board (20HP) - jacks, pots, MIDI TRS, OLED and panel; mates with the 16HP base board",
  "type": "module",
  "main": "index.circuit.tsx",
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build",
    "snapshot": "tsci snapshot",
    "gate": "bash scripts/gate.sh",
    "check": "tsci check netlist",
    "check:placement": "tsci check placement",
    "check:shorts": "tsci check shorts",
    "check:pcb-style": "tsci check pcb-style",
    "check:mating": "python3 scripts/check_mating.py",
    "panel:build": "tsci build panel.circuit.tsx",
    "panel:check": "bun scripts/panel_check.ts",
    "panel:preview": "bun scripts/panel_preview.ts",
    "panel:release": "bun scripts/panel_release.ts",
    "panel:test": "bun test lib/panel",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tscircuit/alphabet": "^0.0.25",
    "tscircuit": "^0.0.3044"
  },
  "devDependencies": {
    "@jscad/modeling": "2.13.0",
    "@jscad/stl-serializer": "2.1.23",
    "@tscircuit/cli": "^0.1.2427",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
