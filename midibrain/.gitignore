tscircuit/node_modules/
tscircuit/dist/
tscircuit/checks/
tscircuit/.tscircuit/
tsccache/
build/
fab/
.DS_Store
# Generated CAD binaries (reproducible from generator scripts; the current
# bracket STL/STEP are generated from mechanical/layout.json — do not commit binaries)
*.stl
*.step
# The STEP/STL verification model writes its whole output set here, including
# assumptions.json and print-checklist.md, which are generated too
# (`make mechanical-cad`, docs/mechanical-cad.md).
mechanical/cad-out/
# CWD droppings from `tsci export` runs (release keeps canonical copies in fab/)
*.circuit-pcb.svg
# Generated board SVGs (reproducible via tsci export; not linked from docs)
assets/front-pcb.svg
assets/base-pcb.svg
# Generated view artifacts not linked from docs (reproducible via make targets;
# the doc-linked renders stay tracked so docs read on any platform)
assets/front-panel-pcb.png
assets/front-3d.png
# Python caches
__pycache__/
*.pyc
mechanical/viewer/node_modules/
mechanical/viewer/models.json
# The viewer's panel silkscreen texture, exported by `make mechanical-steps`
# (`tsci export -f pcb-svg`, reproducible; not a hand-drawn asset).
mechanical/viewer/panel-silk.svg
# CWD dropping from `tsci check` (writes <entry>.circuit.json beside the source)
*.circuit.circuit.json
