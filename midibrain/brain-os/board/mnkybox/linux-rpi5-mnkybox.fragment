# MNKYBOX Raspberry Pi 5 kernel fragment.
#
# Applied on top of the raspberrypi rpi-6.12.y (6.12.61) bcm2712 defconfig
# (BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"). Every entry here is a deliberate
# product decision; nothing is added "just in case".
#
# Real-time behaviour — PREEMPT_RT is enabled, from the kernel tree itself:
#   Linux 6.12 merged PREEMPT_RT upstream and this tree's arm64 port selects
#   ARCH_SUPPORTS_RT (arch/arm64/Kconfig:105), so CONFIG_PREEMPT_RT needs no
#   out-of-tree patch stack and no separate rpi-6.12.y-rt branch. It is chosen
#   over plain PREEMPT because the audio engine's block budget is 2.67 ms with
#   the Pico 2 as clock master, and RT removes the remaining non-preemptible
#   sections (spinlocks become sleeping, priority-inheriting locks). The cost
#   is throughput, which this appliance does not need.
#   `threadirqs` stays on the kernel command line: RT threads interrupt
#   handlers anyway, and the flag keeps the behaviour explicit for anyone
#   reading cmdline.txt. If RT ever has to be dropped, the fallback is
#   CONFIG_PREEMPT + threadirqs + SCHED_FIFO for the audio threads
#   (LimitRTPRIO=95 in the units), and that fallback must be recorded here.
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
# CONFIG_PREEMPT is not set
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_HZ_1000=y
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set
CONFIG_NO_HZ_IDLE=y

# 4 KiB pages: same choice as the upstream Pi 5 fragment (Buildroot
# board/raspberrypi/linux-4k-page-size.fragment). 16 KiB pages gain nothing
# here and break prebuilt userland assumptions.
CONFIG_ARM64_4K_PAGES=y
# CONFIG_ARM64_16K_PAGES is not set

# Touch: Goodix GT911 on the DSI I2C bus of the Waveshare 3.5inch DSI LCD (H).
# The controller reports up to 5 contact points; the driver publishes them as
# Linux input protocol B MT slots, which libinput, Weston and Qt Wayland all
# consume.
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y

# Display path for the DSI panel (vc4-kms-v3d + the Pi 5 DSI host).
CONFIG_DRM=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_V3D=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Audio: interfaces are USB class-compliant devices; DMA-buffer plumbing is
# required by PipeWire's ALSA plugin.
CONFIG_SND=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_SOC=y
CONFIG_SND_DMAENGINE_PCM=y
CONFIG_DMA_SHARED_BUFFER=y

# WiFi: BCM43455 over SDIO (brcmfmac) + regulatory enforcement.
CONFIG_BRCMFMAC=y
CONFIG_CFG80211=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
