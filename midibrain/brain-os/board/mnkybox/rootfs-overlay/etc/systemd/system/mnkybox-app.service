[Unit]
Description=MNKYBOX instrument application
Documentation=file:/opt/mnkybox/CONTRACT.md
# Started only after the sound server and the compositor are up, because the
# application opens a PipeWire/ALSA client and an X11 display.
Wants=pipewire.service wireplumber.service
Requires=weston.service
After=pipewire.service wireplumber.service weston.service
# The stub exits 78 (EX_CONFIG) until the real binary lands; stop retrying
# instead of flapping forever.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=mnkybox
Group=mnkybox
Environment=XDG_RUNTIME_DIR=/run/mnkybox
Environment=WAYLAND_DISPLAY=wayland-0
Environment=DISPLAY=:0
Environment=HOME=/home/mnkybox
LimitRTPRIO=95
LimitMEMLOCK=infinity
LimitNOFILE=65536
ExecStart=/opt/mnkybox/bin/mnkybox
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
