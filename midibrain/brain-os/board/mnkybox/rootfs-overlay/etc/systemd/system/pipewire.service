[Unit]
Description=PipeWire sound server (MNKYBOX)
Documentation=man:pipewire(1)
# One appliance, one session: the user-mode daemon runs as a system unit for
# the mnkybox user, with a fixed runtime directory shared by WirePlumber,
# Weston and the application.
ConditionPathExists=/run/mnkybox
After=systemd-tmpfiles-setup.service
Before=wireplumber.service mnkybox-app.service

[Service]
Type=simple
User=mnkybox
Group=mnkybox
Environment=XDG_RUNTIME_DIR=/run/mnkybox
Environment=PIPEWIRE_RUNTIME_DIR=/run/mnkybox
# Real-time scheduling for the audio threads (module-rt).
LimitRTPRIO=95
LimitMEMLOCK=infinity
LimitNOFILE=65536
ExecStart=/usr/bin/pipewire
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
