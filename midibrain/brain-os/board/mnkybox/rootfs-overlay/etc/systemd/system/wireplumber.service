[Unit]
Description=WirePlumber session and policy manager (MNKYBOX)
Documentation=man:wireplumber(1)
Requires=pipewire.service
After=pipewire.service
PartOf=pipewire.service
Before=mnkybox-app.service

[Service]
Type=simple
User=mnkybox
Group=mnkybox
Environment=XDG_RUNTIME_DIR=/run/mnkybox
Environment=PIPEWIRE_RUNTIME_DIR=/run/mnkybox
LimitRTPRIO=95
LimitMEMLOCK=infinity
ExecStart=/usr/bin/wireplumber
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
