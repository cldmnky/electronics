[Unit]
Description=PipeWire PulseAudio-compatible server (MNKYBOX)
Documentation=man:pipewire-pulse(1)
# The application talks to audio through Qt Multimedia's PulseAudio backend, so
# this is the server it connects to. Qt never speaks the JACK API and never
# opens ALSA directly.
Requires=pipewire.service
After=pipewire.service
PartOf=pipewire.service
Before=mnkybox-app.service

[Service]
Type=simple
ExecStart=/usr/bin/pipewire-pulse
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
