[Unit]
Description=WirePlumber session and policy manager (MNKYBOX)
Documentation=man:wireplumber(1)
# Required session manager: it owns device selection, routing and the default
# sink/source policy in /etc/wireplumber/wireplumber.conf.d/.
Requires=pipewire.service
After=pipewire.service
PartOf=pipewire.service
Before=pipewire-pulse.service mnkybox-app.service

[Service]
Type=simple
ExecStart=/usr/bin/wireplumber
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
